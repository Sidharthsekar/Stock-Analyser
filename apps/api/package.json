{
  "name": "@stock-analyser/api",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "node --loader tsx ./src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest",
    "seed": "node --loader tsx ./src/scripts/seed.ts"
  },
  "dependencies": {
    "@stock-analyser/shared": "workspace:*",
    "argon2": "^0.31.2",
    "cookie": "^0.5.0",
    "fastify": "^4.25.2",
    "fastify-cors": "^6.1.0",
    "fastify-helmet": "^11.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cookie": "^0.5.4",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "axios": "^1.6.5",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}
