{
  "name": "@stock-analyser/api",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "node --loader tsx ./src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest",
    "seed": "node --import tsx ./src/scripts/seed.ts"
  },
  "dependencies": {
    "@stock-analyser/shared": "workspace:*",
    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "fastify": "^5.12.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "axios": "^1.19.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
